# === heavy, reproducible or third-party assets ===

# raw experiment caches (pkl checkpoints)
tracks/*/results/cache_*/
tracks/*/results/viz_*/

# large latent / ssl artifacts
*.ssl.pt
tracks/*/results/**/*.ssl.pt
tracks/*/results/**/*_latents_*.npz
