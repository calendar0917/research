# rebuildable label-free structure caches (never committed)
cache/
# per-run artefacts (checkpoints, curves, predictions, records) stay on disk /
# on the compute host and are summarised into analysis/ at the end of the round
runs/
# python / pytest noise
__pycache__/
.pytest_cache/

# append-only runtime ledgers: written by every run on the compute host, pulled
# back and committed once at the end of the round (never mid-round, or the remote
# worktree would be dirty after each job)
analysis/label_access_ledger.json
analysis/run_registry.json
analysis/compute_ledger.json
analysis/test_access_ledger.json
