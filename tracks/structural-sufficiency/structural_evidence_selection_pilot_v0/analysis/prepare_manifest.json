{
  "commit": "e52ee9349f1343725b6dbc91894596e48ede6a94",
  "config": {
    "arms": {
      "DENSE": {
        "input": "complete original graph",
        "loss": "standardized label MSE"
      },
      "RANDOM": {
        "eval": "uniform single-candidate expectation + fixed label-blind index",
        "input": "all valid candidates, independently encoded",
        "loss": "mean_j (y_j-y)^2, molecule-equal weight"
      },
      "SELECT": {
        "eval": "hard argmax candidate only",
        "input": "all valid candidates, independently encoded",
        "loss": "sum_j p_train_j (y_j-y)^2"
      }
    },
    "candidate": {
      "bfs_tie_break": "pynauty canon_label of the coloured atom/bond incidence graph",
      "deduplicate": "canonical atom-support",
      "disconnected": "candidates stay inside one real connected component; below-k coverage is reported, the full graph is never substituted",
      "diversity": "first = BFS from canonical rank 0; then greedy max-min Jaccard distance, canonical tie-break",
      "features": "selected raw atom categorical columns, induced raw bond categorical columns, candidate-local S1/S2/R2 summaries, candidate-local degree/min_ring/in_cycle and candidate graph scalars",
      "forbidden_inputs": [
        "original atom id",
        "original graph node count",
        "original graph edge count",
        "full-graph descriptors",
        "full-graph R2 hidden representation",
        "selection score",
        "candidate index",
        "candidate count"
      ],
      "generation": "BFS from every atom; first k popped atoms",
      "max_candidates": 4,
      "node_budget": "k = max(1, min(n-1, floor(0.65*n))); n=1 keeps the unique node",
      "node_fraction": 0.65
    },
    "dataset": "ogbg-mollipo",
    "evaluation": {
      "bootstrap_replicates": 1000,
      "bootstrap_seed": 0,
      "bootstrap_unit": "molecule",
      "dense": "full-graph prediction",
