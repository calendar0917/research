  "pair_symmetry": "J[a,b] == J[b,a] by construction",
  "potential_bound": 2.0,
  "normalizer": "logsumexp over all internal state assignments (<= 16 states)",
  "empty_set": "logZ(empty) = 0",
  "sampling": "none",
  "message_passing": "none",
  "per_word_parameters": "none",
  "share_across": ["molecules", "roots", "word types"]
 },
