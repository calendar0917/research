# large, regenerable, host-local
cache/
runs/
runs/**/*.pt
*.pt
*.log

# vendored chemprop shims live under chemprop/data and must be tracked
!code/vendor/cpv221/chemprop/data/
!code/vendor/cpv221/chemprop/data/__init__.py

# small, content-addressed evidence is committed explicitly
!analysis/**/*.json
!analysis/**/*.csv
!analysis/**/*.md
!analysis/**/*.png
!analysis/**/*.npz
