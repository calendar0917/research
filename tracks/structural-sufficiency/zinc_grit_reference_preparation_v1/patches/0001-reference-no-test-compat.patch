+def _reference_requested_splits():
+    """Return the explicitly enabled ZINC splits.
+
+    The official loader always constructs train/val/test.  This reference
+    preparation must never construct the official test split, so the allowed
+    set is hard-limited to train and (optionally) val.  With no `reference`
+    config section the historical three-split behaviour is preserved for
+    upstream compatibility.
+    """
+    ref = cfg.get('reference', None)
+    if ref is None:
+        return ('train', 'val', 'test')
+    spec = ref.get('splits', 'train,val,test')
+    if isinstance(spec, str):
+        splits = tuple(x.strip() for x in spec.split(',') if x.strip())
+    else:
+        splits = tuple(spec)
+    if 'test' in splits:
+        raise ValueError(
+            "The official test split is disabled for this reference bundle; "
+            "remove 'test' from reference.splits")
+    if splits not in (('train',), ('train', 'val')):
+        raise ValueError(
+            f"reference.splits must be 'train' or 'train,val', got {splits!r}")
+    return splits
+
